# APP
PORT=3000
NODE_ENV=development
API_PREFIX=api
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# JWT — Generar con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=15m

# JWT Refresh — Generar con: openssl rand -hex 32
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d

# EMAIL — Obtener desde el panel de Mailtrap (deben regenerarse desde la plataforma)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=
RESET_CODE_EXPIRATION=15

# CLOUDINARY (opcional)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_FOLDER=proyecto-integrador

# DATABASE — Reemplazar PASSWORD con el valor generado por: openssl rand -hex 32
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/carmen_goudie
