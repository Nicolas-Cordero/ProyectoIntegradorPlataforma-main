# ── Aplicación ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
API_PREFIX=api

# ── CORS ──────────────────────────────────────────────────────────────────────
# Lista de orígenes exactos permitidos, separados por coma.
# En producción es obligatorio. En desarrollo se permiten localhost/* automáticamente.
# CORS_ORIGINS=https://tu-frontend.azurestaticapps.net
# Patrones regex opcionales separados por coma.
# CORS_PATTERNS=^https://.*\.vercel\.app$

# ── JWT — Generar con: openssl rand -hex 32 ───────────────────────────────────
JWT_SECRET=
JWT_EXPIRATION=15m

# ── JWT Refresh — Generar con: openssl rand -hex 32 ──────────────────────────
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d
JWT_REFRESH_EXPIRATION_MOBILE=90d

# ── Email (Mailtrap en desarrollo; SMTP real en producción) ───────────────────
# Cualquier proveedor SMTP es compatible: Resend, SendGrid, Mailgun, AWS SES, Mailtrap, etc.
# Solo cambia HOST, PORT, USER y PASSWORD según el proveedor.
EMAIL_FROM=no-reply@tudominio.cl
EMAIL_FROM_NAME=Nombre que verá el destinatario
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=
# Tiempo en minutos que el código de recuperación de contraseña permanece válido.
RESET_CODE_EXPIRATION=15

# ── Cloudinary (subida de archivos e imágenes) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FILE_FOLDER=proyecto-integrador/archivos
CLOUDINARY_IMAGE_FOLDER=proyecto-integrador/imagenes

# ── Base de datos ─────────────────────────────────────────────────────────────
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB
# En producción apunta a Azure Database for PostgreSQL.
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/carmen_goudie
