// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

enum EstadoBeneficio {
  ACTIVO
  SUSPENDIDO
  FINALIZADO
  RECHAZADO
  EN_TRAMITE
}


enum EstadoRamo {
  APROBADO
  REPROBADO
  CURSANDO
  ELIMINADO
}


enum Topico {
  GENERAL
  ACADEMICO
  REL_INTER
  SALUD
  ACTS_EXTRA
}

enum EstadoEstudiante {
  ACTIVO
  CONDICIONAL
  ELIMINADO
  SUSPENDIDO
  RETIRADO
  EGRESADO
  TITULADO
}


enum UserRol {
  ADMIN
  TUTOR
  VISITA
  ESTUDIANTE
}


enum TipoBeneficio {
  ARANCEL
  MANUTENCION
}

enum TipoSemestre {
  REGULAR
  RECUPERATIVO
}

enum Genero {
  MASCULINO
  FEMENINO
  NO_BINARIO
}



model usuario {
  rut_usuario   String   @id
  nombre        String
  apellido      String
  email         String   @unique
  telefono      String
  rol           UserRol
  password      String

  ultimo_login  DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  reset_token           String? 
  reset_token_expires   DateTime?

  entrevistas entrevista[] @relation("Entrevistador")
  audit_logs  audit_log[]
}



model universidad {
  codigo_universidad Int    @id @default(autoincrement())
  nombre             String @unique
  comuna             Int

  carreras carrera[]
}



model liceo {
  rbd          String @id
  nombre       String
  comuna       String
  especialidad String

  estudiantes estudiante[]
}



model beneficio {
  codigo_beneficio Int     @id @default(autoincrement())
  nombre           String  @unique
  proveedor        String
  tipo             TipoBeneficio
  descripcion      String
  monto            Decimal

  beneficio_estudiante beneficio_estudiante[]
}



model semestre {
  semestre_id Int    @id @default(autoincrement())
  year        Int
  semestre    String
  tipo        TipoSemestre

  ramos       ramo[]
  entrevistas entrevista[]
}



model estudiante {
  rut_estudiante   String  @id
  nombre           String
  apellido         String
  email            String  @unique
  telefono         String
  generacion       String
  fecha_nacimiento DateTime
  direccion        String
  genero           Genero

  rbd_liceo        String
  puntaje_paes     Int?

  foto_url         String?

  estado           EstadoEstudiante
  promedios_media  Decimal @db.Decimal(3,1)

  liceo liceo @relation(fields: [rbd_liceo], references: [rbd])

  familiares  familiar[]
  beneficios  beneficio_estudiante[]
  carreras    carrera[]
  ramos       ramo[]
  entrevistas entrevista[]
}



model familiar {
  id             Int @id @default(autoincrement())
  rut_familiar   String
  rut_estudiante String
  nombre         String
  telefono       String
  parentesco     String
  observacion    String

  estudiante estudiante @relation(fields: [rut_estudiante], references: [rut_estudiante])

  @@unique([rut_familiar, rut_estudiante])
}



model beneficio_estudiante {
  codigo_beneficio Int
  rut_estudiante   String
  estado           EstadoBeneficio
  inicio           DateTime
  fin              DateTime

  beneficio  beneficio  @relation(fields: [codigo_beneficio], references: [codigo_beneficio])
  estudiante estudiante @relation(fields: [rut_estudiante], references: [rut_estudiante])

  @@id([codigo_beneficio, rut_estudiante])
}




model carrera {
  codigo_carrera     Int    @id @default(autoincrement())
  nombre             String
  rut_estudiante     String
  duracion_sem       Int
  codigo_universidad Int
  via_acceso         String

  estudiante  estudiante  @relation(fields: [rut_estudiante], references: [rut_estudiante])
  universidad universidad @relation(fields: [codigo_universidad], references: [codigo_universidad])

  ramos ramo[]
}





model ramo {
  id              Int @id @default(autoincrement())
  semestre_id     Int
  rut_estudiante  String
  codigo_carrera  Int
  nombre          String
  estado          EstadoRamo
  comentario      String
  intento         Int

  estudiante estudiante @relation(fields: [rut_estudiante], references: [rut_estudiante])
  semestre   semestre   @relation(fields: [semestre_id], references: [semestre_id])
  carrera    carrera    @relation(fields: [codigo_carrera], references: [codigo_carrera])

  notas nota[]

  @@unique([nombre, semestre_id, rut_estudiante, codigo_carrera])
}





model nota {
  id         Int      @id @default(autoincrement())
  ramo_id    Int
  fecha_hora DateTime
  nota       Decimal

  ramo ramo @relation(fields: [ramo_id], references: [id])

  @@unique([ramo_id, fecha_hora])
}





model entrevista {
  id                Int @id @default(autoincrement())
  fecha_hora        DateTime
  rut_estudiante    String
  semestre_id       Int
  duracion_s        Int
  rut_entrevistador String
  resumen           String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  estudiante   estudiante @relation(fields: [rut_estudiante], references: [rut_estudiante])
  semestre     semestre   @relation(fields: [semestre_id], references: [semestre_id])
  entrevistador usuario   @relation("Entrevistador", fields: [rut_entrevistador], references: [rut_usuario])
  
  comentarios comentario[]

  @@unique([rut_estudiante, rut_entrevistador, fecha_hora])
}





model comentario {
  id                    Int @id @default(autoincrement())
  entrevista_id         Int
  topico                Topico
  texto                 String
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  entrevista entrevista @relation(fields: [entrevista_id], references: [id])
  @@unique([entrevista_id, topico])
}





model audit_log {
  id          Int @id @default(autoincrement())
  rut_usuario String
  descripcion String
  created_at  DateTime @default(now())

  usuario usuario @relation(fields: [rut_usuario], references: [rut_usuario])
}