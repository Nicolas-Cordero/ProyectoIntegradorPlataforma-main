// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}
datasource db {
  provider = "postgresql"
}

enum EstadoBeneficio {
  ACTIVO
  SUSPENDIDO
  FINALIZADO
  RECHAZADO
  EN_TRAMITE
}


enum EstadoRamo {
  APROBADO
  REPROBADO
  CURSANDO
  ELIMINADO
}


enum Topico {
  GENERAL
  ACADEMICO
  REL_INTER
  SALUD
  ACTS_EXTRA
}

enum EstadoEstudiante {
  ACTIVO
  ELIMINADO
  SUSPENDIDO
  RETIRADO
  EGRESADO
  TITULADO
}


enum UserRol {
  ADMIN
  TUTOR
  VISITA
  ESTUDIANTE
}


enum TipoBeneficio {
  ARANCEL
  MANUTENCION
}

enum TipoSemestre {
  REGULAR
  RECUPERATIVO
}

enum Genero {
  MASCULINO
  FEMENINO
  NO_BINARIO
}

enum Parentesco {
  PADRE
  MADRE
  ABUELO
  ABUELA
  HERMANO
  HERMANA
  TIO
  TIA
  PRIMO
  PRIMA
  OTRO
}

enum ViaAcceso {
  ESPECIAL
  REGULAR
  PACE
}



model usuario {
  rut_usuario   String   @id
  nombre        String
  apellido      String
  email         String   @unique
  telefono      String
  rol           UserRol
  password      String

  activo                Boolean  @default(true)
  must_change_password  Boolean  @default(true)

  ultimo_login  DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  reset_token           String?
  reset_token_expires   DateTime?

  entrevistas entrevista[] @relation("Entrevistador")
  audit_logs  audit_log[]
  refresh_tokens refresh_token[]
  historial_estados historial_estado_carrera[]
}



model refresh_token {
  id          Int      @id @default(autoincrement())
  rut_usuario String
  token_hash  String   @unique
  token_id    String
  expires_at  DateTime
  revoked     Boolean  @default(false)
  created_at  DateTime @default(now())

  usuario usuario @relation(fields: [rut_usuario], references: [rut_usuario])

  @@index([rut_usuario])
}



model universidad {
  codigo_universidad Int    @id @default(autoincrement())
  nombre             String @unique
  comuna             String

  carreras carrera[]
}



model liceo {
  rbd          String @id
  nombre       String
  comuna       String
  especialidad String

  estudiantes estudiante[]
}



model beneficio {
  codigo_beneficio Int     @id @default(autoincrement())
  nombre           String  @unique
  proveedor        String
  tipo             TipoBeneficio
  descripcion      String
  monto            Decimal

  beneficio_estudiante beneficio_estudiante[]
}



model semestre {
  semestre_id Int    @id @default(autoincrement())
  year        Int
  semestre    String
  tipo        TipoSemestre

  ramos              ramo[]
  entrevistas        entrevista[]
  semestre_carreras  semestre_carrera[]

  @@unique([year, semestre])
}

model semestre_carrera {
  semestre_id    Int
  codigo_carrera Int

  // Cierre explícito del semestre para esta carrera. Es un flag persistido
  // a propósito (no derivado del estado de los ramos): solo lo cambia la
  // acción de cierre del admin/tutor, para que un estudiante no pueda cerrar
  // el semestre indirectamente cambiando el estado de sus propios ramos.
  cerrado Boolean @default(false)

  semestre semestre @relation(fields: [semestre_id],    references: [semestre_id])
  carrera  carrera  @relation(fields: [codigo_carrera], references: [codigo_carrera])

  @@id([semestre_id, codigo_carrera])
}



model generacion {
  id          Int          @id @default(autoincrement())
  año         Int          @unique
  descripcion String?
  estudiantes estudiante[]
}

model estudiante {
  rut_estudiante   String  @id
  nombre           String
  apellido         String
  email            String  @unique
  telefono         String
  fecha_nacimiento DateTime
  direccion        String
  genero           Genero

  rbd_liceo        String
  puntaje_paes     Int?

  foto_url         String?

  promedios_media  Decimal @db.Decimal(3,1)

  generacion_id    Int

  generacion_rel   generacion @relation(fields: [generacion_id], references: [id])
  liceo liceo @relation(fields: [rbd_liceo], references: [rbd])

  familiares  familiar[]
  beneficios  beneficio_estudiante[]
  carreras    carrera[]
  ramos       ramo[]
  entrevistas entrevista[]
  contactos_emergencia contacto_emergencia[]
  paes paes?
  firmas_acuerdo firma_acuerdo[]
}



model familiar {
  id                    Int     @id @default(autoincrement())
  rut_estudiante        String
  nombre                String
  telefono              String
  parentesco            Parentesco
  observacion           String?
  es_contacto_emergencia Boolean @default(false)

  estudiante estudiante @relation(fields: [rut_estudiante], references: [rut_estudiante])

  contactos_emergencia contacto_emergencia[]

  @@unique([id, rut_estudiante])
}


model contacto_emergencia {
  id              Int    @id @default(autoincrement())
  id_familiar     Int
  rut_estudiante  String

  estudiante estudiante @relation(fields: [rut_estudiante], references: [rut_estudiante])
  familiar   familiar   @relation(fields: [id_familiar], references: [id])
}



model beneficio_estudiante {
  codigo_beneficio Int
  rut_estudiante   String
  estado           EstadoBeneficio
  inicio           DateTime
  fin              DateTime

  beneficio  beneficio  @relation(fields: [codigo_beneficio], references: [codigo_beneficio])
  estudiante estudiante @relation(fields: [rut_estudiante], references: [rut_estudiante])

  @@id([codigo_beneficio, rut_estudiante])
}




model carrera {
  codigo_carrera     Int    @id @default(autoincrement())
  nombre             String
  rut_estudiante     String
  duracion_sem       Int
  codigo_universidad Int
  via_acceso         ViaAcceso
  estado             EstadoEstudiante @default(ACTIVO)
  anio_ingreso       Int

  estudiante  estudiante  @relation(fields: [rut_estudiante], references: [rut_estudiante])
  universidad universidad @relation(fields: [codigo_universidad], references: [codigo_universidad])

  ramos             ramo[]
  semestre_carreras semestre_carrera[]
  historial_estados historial_estado_carrera[]
}



 

model ramo {
  id              Int @id @default(autoincrement())
  semestre_id     Int
  rut_estudiante  String
  codigo_carrera  Int
  nombre          String
  estado          EstadoRamo
  comentario      String
  intento         Int
  nota_final      Decimal?
  url_certificado String?

  estudiante estudiante @relation(fields: [rut_estudiante], references: [rut_estudiante])
  semestre   semestre   @relation(fields: [semestre_id], references: [semestre_id])
  carrera    carrera    @relation(fields: [codigo_carrera], references: [codigo_carrera])

  @@unique([nombre, semestre_id, rut_estudiante, codigo_carrera])
}



model entrevista {
  id                Int @id @default(autoincrement())
  fecha_hora        DateTime
  rut_estudiante    String
  semestre_id       Int
  duracion_s        Int
  rut_entrevistador String
  resumen           String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  estudiante   estudiante @relation(fields: [rut_estudiante], references: [rut_estudiante])
  semestre     semestre   @relation(fields: [semestre_id], references: [semestre_id])
  entrevistador usuario   @relation("Entrevistador", fields: [rut_entrevistador], references: [rut_usuario])
  
  comentarios comentario[]

  @@unique([rut_estudiante, rut_entrevistador, fecha_hora])
}





model comentario {
  id                    Int @id @default(autoincrement())
  entrevista_id         Int
  topico                Topico
  texto                 String
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  entrevista entrevista @relation(fields: [entrevista_id], references: [id])
  @@unique([entrevista_id, topico])
}

model paes {
  id              Int    @id @default(autoincrement())
  rut_estudiante  String @unique
  matematicas     Int
  lenguaje        Int
  nem             Int
  ranking         Int
  matematicas2    Int?
  ciencias        Int?
  historia        Int?

  estudiante estudiante @relation(fields: [rut_estudiante], references: [rut_estudiante])
}

model acuerdo {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  documento Json

  firmas    firma_acuerdo[]
}

// Cada fila registra que un estudiante firmó una versión concreta del acuerdo.
// La política de negocio es firmar SIEMPRE la versión vigente; como cada edición
// del acuerdo crea una fila nueva en `acuerdo`, una versión nueva nace sin firmas
// (la ausencia de fila = "no firmado"), sin necesidad de resetear nada.
model firma_acuerdo {
  id             Int      @id @default(autoincrement())
  acuerdo_id     Int
  rut_estudiante String
  firmado_at     DateTime @default(now())

  acuerdo    acuerdo    @relation(fields: [acuerdo_id], references: [id], onDelete: Cascade)
  estudiante estudiante @relation(fields: [rut_estudiante], references: [rut_estudiante], onDelete: Cascade)

  @@unique([acuerdo_id, rut_estudiante]) // idempotente: un estudiante firma una versión a lo más una vez
  @@index([rut_estudiante])
}



model audit_log {
  id          Int @id @default(autoincrement())
  rut_usuario String
  descripcion String
  created_at  DateTime @default(now())

  usuario usuario @relation(fields: [rut_usuario], references: [rut_usuario])
}

model historial_estado_carrera {
  id              Int               @id @default(autoincrement())
  codigo_carrera  Int
  estado_anterior EstadoEstudiante?
  estado_nuevo    EstadoEstudiante
  rut_usuario     String
  created_at      DateTime          @default(now())

  carrera carrera  @relation(fields: [codigo_carrera], references: [codigo_carrera])
  usuario usuario  @relation(fields: [rut_usuario],    references: [rut_usuario])
}